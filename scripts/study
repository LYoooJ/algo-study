#!/usr/bin/env bash

set -euo pipefail

GH_BIN="${STUDY_GH_BIN:-gh}"
UPSTREAM="${STUDY_UPSTREAM:-algo-gongbu/algo-study}"
BASE_BRANCH="${STUDY_BASE_BRANCH:-main}"
AUTO_MOVE_WORKFLOW="${STUDY_AUTO_MOVE_WORKFLOW:-auto-move.yml}"

log() {
  printf '[study] %s\n' "$*"
}

fail() {
  printf '[study] 오류: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
알고리즘 스터디 GitHub 자동화

사용법:
  gh study start [--discard] [--dry-run]
  gh study submit [--note "풀이 핵심"] [--no-merge] [--dry-run]

명령:
  start       문제를 풀기 전에 내 fork main을 원본 main과 동기화합니다.
  submit      auto-move 확인, 브랜치 생성, PR 작성, Merge commit,
              fork 재동기화를 순서대로 실행합니다.

옵션:
  --discard   아직 제출하지 않은 fork 변경을 버리고 동기화합니다.
  --note      PR 본문에 남길 풀이 핵심입니다.
  --no-merge  PR만 만들고 자동 병합하지 않습니다.
  --dry-run   변경 없이 실행 예정 내용만 확인합니다.
EOF
}

ghx() {
  "$GH_BIN" "$@"
}

require_gh() {
  command -v "$GH_BIN" >/dev/null 2>&1 || fail "GitHub CLI(gh)를 먼저 설치해 주세요."
  ghx auth status >/dev/null 2>&1 || fail "gh auth login으로 GitHub에 먼저 로그인해 주세요."
}

load_repository_context() {
  LOGIN="$(ghx api user --jq '.login')"
  REPO_NAME="${UPSTREAM#*/}"
  FORK="${LOGIN}/${REPO_NAME}"

  local parent
  parent="$(ghx api "repos/${FORK}" --jq '.parent.full_name // ""' 2>/dev/null)" || \
    fail "${FORK} fork가 없습니다. 먼저 ${UPSTREAM}을 fork해 주세요."

  [ "$parent" = "$UPSTREAM" ] || \
    fail "${FORK}는 ${UPSTREAM}의 fork가 아닙니다."
}

compare_endpoint() {
  printf 'repos/%s/compare/%s...%s:%s' "$UPSTREAM" "$BASE_BRANCH" "$LOGIN" "$BASE_BRANCH"
}

command_start() {
  local discard=false
  local dry_run=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --discard) discard=true ;;
      --dry-run) dry_run=true ;;
      -h|--help) usage; exit 0 ;;
      *) fail "start에서 지원하지 않는 옵션입니다: $1" ;;
    esac
    shift
  done

  load_repository_context

  local endpoint ahead behind
  endpoint="$(compare_endpoint)"
  ahead="$(ghx api "$endpoint" --jq '.ahead_by')"
  behind="$(ghx api "$endpoint" --jq '.behind_by')"

  if [ "$ahead" -gt 0 ] && [ "$discard" != true ]; then
    printf '[study] 내 fork에 원본에 없는 커밋이 %s개 있습니다.\n' "$ahead" >&2
    ghx api "$endpoint" --jq '.files[].filename' >&2 || true
    fail "미제출 풀이일 수 있어 동기화를 중단했습니다. 먼저 submit하거나, 정말 버리려면 start --discard를 사용하세요."
  fi

  log "동기화 대상: ${FORK}:${BASE_BRANCH} ← ${UPSTREAM}:${BASE_BRANCH}"
  log "현재 차이: fork ahead ${ahead}, behind ${behind}"

  if [ "$dry_run" = true ]; then
    [ "$discard" = true ] && log "실행 시 fork 변경을 버리고 강제 동기화합니다."
    log "dry-run 완료: 원격 저장소는 변경하지 않았습니다."
    return
  fi

  if [ "$discard" = true ]; then
    ghx repo sync "$FORK" --source "$UPSTREAM" --branch "$BASE_BRANCH" --force
  else
    ghx repo sync "$FORK" --source "$UPSTREAM" --branch "$BASE_BRANCH"
  fi

  log "동기화 완료. 이제 문제를 풀어 주세요."
}

latest_auto_move_run() {
  ghx run list \
    --repo "$FORK" \
    --workflow "$AUTO_MOVE_WORKFLOW" \
    --limit 1 \
    --json databaseId,status,conclusion,url,headSha \
    --jq '.[0] | [.databaseId, .status, (.conclusion // ""), .url, .headSha] | @tsv'
}

verify_auto_move() {
  local dry_run="$1"
  local run_data run_id run_status run_conclusion run_url run_head

  run_data="$(latest_auto_move_run)"
  [ -n "$run_data" ] || fail "auto-move 실행 기록이 없습니다. 문제 업로드 후 다시 실행해 주세요."
  IFS=$'\t' read -r run_id run_status run_conclusion run_url run_head <<< "$run_data"

  if [ "$run_status" != "completed" ]; then
    if [ "$dry_run" = true ]; then
      fail "auto-move가 아직 ${run_status} 상태입니다: ${run_url}"
    fi
    log "auto-move 완료를 기다립니다: ${run_url}"
    ghx run watch "$run_id" --repo "$FORK" --exit-status
    run_data="$(latest_auto_move_run)"
    IFS=$'\t' read -r run_id run_status run_conclusion run_url run_head <<< "$run_data"
  fi

  [ "$run_status" = "completed" ] && [ "$run_conclusion" = "success" ] || \
    fail "auto-move가 성공하지 않았습니다: ${run_url}"

  log "auto-move 성공 확인: ${run_url}"
}

detect_problem() {
  local endpoint files file relative remainder root
  local problem_root=""
  local unexpected_count=0

  endpoint="$(compare_endpoint)"
  files="$(ghx api "$endpoint" --jq '.files[].filename')"
  [ -n "$files" ] || fail "제출할 문제 변경을 찾지 못했습니다. 먼저 문제를 풀어 주세요."

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    case "$file" in
      "$MEMBER_ID"/백준/*|"$MEMBER_ID"/프로그래머스/*)
        relative="${file#"$MEMBER_ID"/}"
        IFS='/' read -r PLATFORM LEVEL PROBLEM_SEGMENT remainder <<< "$relative"
        [ -n "${PROBLEM_SEGMENT:-}" ] || fail "문제 경로를 해석할 수 없습니다: ${file}"
        root="${MEMBER_ID}/${PLATFORM}/${LEVEL}/${PROBLEM_SEGMENT}"
        if [ -n "$problem_root" ] && [ "$problem_root" != "$root" ]; then
          fail "두 개 이상의 문제 변경이 감지됐습니다. 문제를 하나씩 제출해 주세요: ${problem_root}, ${root}"
        fi
        problem_root="$root"
        ;;
      *)
        printf '[study] 예상하지 못한 변경: %s\n' "$file" >&2
        unexpected_count=$((unexpected_count + 1))
        ;;
    esac
  done <<< "$files"

  [ "$unexpected_count" -eq 0 ] || \
    fail "문제 폴더 밖의 변경이 있어 안전을 위해 제출을 중단했습니다."
  [ -n "$problem_root" ] || fail "${MEMBER_ID} 폴더에서 문제를 찾지 못했습니다."

  PROBLEM_NUMBER="${PROBLEM_SEGMENT%%.*}"
  [[ "$PROBLEM_NUMBER" =~ ^[0-9]+$ ]] || \
    fail "문제 번호를 해석할 수 없습니다: ${PROBLEM_SEGMENT}"
  PROBLEM_ROOT="$problem_root"
}

build_pr_metadata() {
  case "$PLATFORM" in
    백준)
      local lower_level
      lower_level="$(printf '%s' "$LEVEL" | tr '[:upper:]' '[:lower:]')"
      BRANCH="boj/${LEVEL}/${PROBLEM_NUMBER}"
      PR_TITLE="Boj/${lower_level}/${PROBLEM_NUMBER}"
      ;;
    프로그래머스)
      BRANCH="pro/level${LEVEL}/${PROBLEM_NUMBER}"
      PR_TITLE="Pro/level${LEVEL}/${PROBLEM_NUMBER}"
      ;;
    *) fail "지원하지 않는 플랫폼입니다: ${PLATFORM}" ;;
  esac
}

command_submit() {
  local note=""
  local no_merge=false
  local dry_run=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --note)
        [ "$#" -ge 2 ] || fail "--note 뒤에 풀이 핵심을 입력해 주세요."
        note="$2"
        shift
        ;;
      --no-merge) no_merge=true ;;
      --dry-run) dry_run=true ;;
      -h|--help) usage; exit 0 ;;
      *) fail "submit에서 지원하지 않는 옵션입니다: $1" ;;
    esac
    shift
  done

  load_repository_context
  verify_auto_move "$dry_run"

  MEMBER_ID="$(ghx api "repos/${FORK}/actions/variables/BAEKJOON_ID" --jq '.value' 2>/dev/null)" || \
    fail "fork의 Actions 변수 BAEKJOON_ID를 먼저 등록해 주세요."
  [ -n "$MEMBER_ID" ] || fail "BAEKJOON_ID 값이 비어 있습니다."

  detect_problem
  build_pr_metadata

  local head_sha
  head_sha="$(ghx api "repos/${FORK}/commits/${BASE_BRANCH}" --jq '.sha')"

  log "감지한 문제: ${PROBLEM_ROOT}"
  log "생성할 브랜치: ${LOGIN}:${BRANCH}"
  log "PR 제목: ${PR_TITLE}"
  [ "$no_merge" = true ] && log "PR 생성 후 병합은 생략합니다."

  if [ "$dry_run" = true ]; then
    log "dry-run 완료: 브랜치, PR, 원본 저장소는 변경하지 않았습니다."
    return
  fi

  local pr_body pr_data pr_number pr_url
  [ -n "$note" ] || note="풀이 과정은 문제 README와 제출 코드를 참고해 주세요."
  pr_body="$(printf '## 문제\n- 경로: `%s`\n- 플랫폼: %s\n- 난이도: %s\n- 문제 번호: %s\n\n## 풀이 메모\n%s\n' \
    "$PROBLEM_ROOT" "$PLATFORM" "$LEVEL" "$PROBLEM_NUMBER" "$note")"

  if ! ghx api --method POST "repos/${FORK}/git/refs" \
    -f "ref=refs/heads/${BRANCH}" \
    -f "sha=${head_sha}" >/dev/null; then
    fail "${BRANCH} 브랜치를 만들지 못했습니다. 같은 이름의 기존 브랜치가 있는지 확인해 주세요."
  fi

  pr_data="$(ghx api --method POST "repos/${UPSTREAM}/pulls" \
    -f "title=${PR_TITLE}" \
    -f "head=${LOGIN}:${BRANCH}" \
    -f "base=${BASE_BRANCH}" \
    -f "body=${pr_body}" \
    --jq '[.number, .html_url] | @tsv')"
  IFS=$'\t' read -r pr_number pr_url <<< "$pr_data"
  log "PR 생성 완료: ${pr_url}"

  if [ "$no_merge" = true ]; then
    log "코드 확인 후 직접 Merge commit해 주세요."
    return
  fi

  ghx pr merge "$pr_number" \
    --repo "$UPSTREAM" \
    --merge \
    --delete-branch \
    --match-head-commit "$head_sha"
  log "Merge commit 완료: ${pr_url}"

  ghx repo sync "$FORK" --source "$UPSTREAM" --branch "$BASE_BRANCH" --force
  log "fork 재동기화 완료. 다음 문제 전에 다시 start를 실행해 주세요."
}

main() {
  require_gh

  local command="${1:-}"
  [ "$#" -gt 0 ] && shift
  case "$command" in
    start) command_start "$@" ;;
    submit) command_submit "$@" ;;
    help|-h|--help|"") usage ;;
    *) fail "지원하지 않는 명령입니다: ${command}" ;;
  esac
}

main "$@"
